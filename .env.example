# Server
NODE_ENV=development
PORT=5000

# Session secret (REQUIRED)
# Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-secret

# Initial database seed admin (REQUIRED only when running npm run seed)
# Never commit real credentials.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=replace-with-a-unique-password

# Optional second seeded admin
SEED_SECOND_ADMIN_EMAIL=
SEED_SECOND_ADMIN_USERNAME=
SEED_SECOND_ADMIN_PASSWORD=

# Backward-compatible password fallback used only by the seed script
ADMIN_PASSWORD=

# PostgreSQL
DATABASE_URL=postgresql://username:password@localhost:5432/trosheencrafts

# SMTP / email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Trosheen.Crafts <noreply@trosheen.shop>"
ADMIN_EMAIL=info@trosheen.shop

# SumUp
SUMUP_API_KEY=
SUMUP_MERCHANT_CODE=

# Public application URLs
FRONTEND_URL=http://localhost:5173
SITE_URL=https://trosheen.shop

# Social cross-posting (optional)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
