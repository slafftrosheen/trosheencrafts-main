# Server
NODE_ENV=development
PORT=5000

# Session Secret (REQUIRED - generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# MUST be a secure random string, at least 32 characters
SESSION_SECRET=your-super-secret-session-key-change-this-in-production

# Admin Setup (REQUIRED for initial database seeding)
# MUST be at least 8 characters long
ADMIN_PASSWORD=change-this-secure-admin-password

# Database (PostgreSQL - local or remote)
DATABASE_URL=postgresql://username:password@localhost:5432/your_database

# Email (Nodemailer - local SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=Your Store <noreply@yourstore.com>
ADMIN_EMAIL=admin@yourstore.com

# Stripe (ONLY external service - for payments)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key

# Frontend URL
FRONTEND_URL=http://localhost:5173
SITE_URL=https://trosheencrafts.vercel.app

# Social Media Cross-Posting (Optional)
# Instagram (requires Facebook Business Account linked to Instagram)
INSTAGRAM_ACCESS_TOKEN=your_instagram_graph_api_token
INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id

# Facebook Page
FACEBOOK_ACCESS_TOKEN=your_facebook_page_access_token
FACEBOOK_PAGE_ID=your_facebook_page_id

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_channel_or_chat_id
